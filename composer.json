{
  "name": "johannschopplich/kirby-deploy-trigger",
  "description": "Start a deployment from a Panel button",
  "type": "kirby-plugin",
  "version": "1.1.0",
  "keywords": [
    "kirby",
    "kirby-cms",
    "kirby-plugin",
    "deployment"
  ],
  "license": "MIT",
  "homepage": "https://kirby.tools/deploy-trigger",
  "authors": [
    {
      "name": "Johann Schopplich",
      "email": "hello@johannschopplich.com",
      "homepage": "https://johannschopplich.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "getkirby/composer-installer": "^1"
  },
  "require-dev": {
    "getkirby/cms": "^5",
    "phpunit/phpunit": "^12",
    "vlucas/phpdotenv": "^5"
  },
  "scripts": {
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 -t playground/public vendor/getkirby/cms/router.php"
    ],
    "csfix": "@php tools/phpcs/vendor/bin/php-cs-fixer fix",
    "test": "phpunit",
    "dist": "composer install --no-dev"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "extra": {
    "kirby-cms-path": false,
    "kirby": {
      "compatible": "^4.0 || ^5.0"
    }
  }
}
