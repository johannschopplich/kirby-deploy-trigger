{
  "name": "kirby-deploy-trigger",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "scripts": {
    "dev": "kirbyup dev src/panel/index.ts",
    "build": "kirbyup src/panel/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"src/panel/**\" --write",
    "test:types": "vue-tsc --noEmit",
    "release": "pnpm run build && bumpp --all --execute \"npx zx scripts/pre-release.mjs\""
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "jiti": "^2.7.0",
    "kirby-types": "^2.0.0-beta.4",
    "kirbyup": "^4.0.0-beta.1",
    "kirbyuse": "^2.0.0-beta.4",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13",
    "zx": "^8.8.5"
  }
}
