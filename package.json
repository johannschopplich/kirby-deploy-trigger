{
  "name": "kirby-deploy-trigger",
  "type": "module",
  "version": "1.1.1",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "kirbyup serve src/panel/index.ts",
    "build": "kirbyup src/panel/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"src/panel/**\" --write",
    "test:types": "tsc --noEmit",
    "release": "pnpm run build && bumpp --all --execute \"npx zx scripts/pre-release.mjs\""
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/node": "^26.6.11",
    "bumpp": "^12.3.0",
    "eslint": "^10.15.0",
    "jiti": "^2.7.0",
    "kirby-types": "^1.9.0",
    "kirbyup": "^3.5.1",
    "kirbyuse": "^1.4.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vue": "^2.7.16",
    "zx": "^8.8.5"
  }
}
